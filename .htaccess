# VenSaas LabTech - Central Multi-Tenant Routing & Security
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Backwards Compatibility: If a lab is accessed at /lab_name/ and exists in /ap/lab_name/, transparently rewrite
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/ap/$1 -d
    RewriteRule ^([^/]+)/(.*)$ ap/$1/$2 [L,QSA]

    # 2. Prevent direct browsing of sensitive backup dumps, environment files, or logs
    <FilesMatch "(^\.env|\.sql$|\.log$|\.bak$)">
        Require all denied
    </FilesMatch>

    # 3. HTTP Security Headers
    <IfModule mod_headers.c>
        Header always set X-Frame-Options "SAMEORIGIN"
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        Header always set X-XSS-Protection "1; mode=block"
    </IfModule>
</IfModule>
