# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
*.log
.vscode/
.idea/

# AI Coding Assistant Brain & Scratch Files
.gemini/
scratch/

# Archives & Temporary Backups (Avoid Git 100MB file limit)
*.zip
*.tar.gz
*.rar
*.7z

# Dynamic QR code temp generation (keep directory structure)
base/qrtemp/*.png
demo/qrtemp/*.png
!base/qrtemp/.gitkeep
!demo/qrtemp/.gitkeep

# Session / Temp uploads if applicable
*/uploads/temp/*

# Environment variables & secrets (NEVER commit to Git)
.env
.env.local
.env.*.local

# -------------------------------------------------------------------
# Multi-Tenant Lab State Directories (NEVER commit or wipe tenant labs)
# State directory structure is tracked via .gitkeep, but all individual
# lab tenant folders inside are completely protected from Git deployments
# (e.g. Hostinger/cPanel git clean / git pull will NEVER touch them)
# -------------------------------------------------------------------
/ap/*
!/ap/.gitkeep

/ts/*
!/ts/.gitkeep

/os/*
!/os/.gitkeep

/od/*
!/od/.gitkeep

/ka/*
!/ka/.gitkeep

/tn/*
!/tn/.gitkeep

/mh/*
!/mh/.gitkeep

/dl/*
!/dl/.gitkeep

/wb/*
!/wb/.gitkeep

/kl/*
!/kl/.gitkeep

/labs/*
!/labs/.gitkeep

